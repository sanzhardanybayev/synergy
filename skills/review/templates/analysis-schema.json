{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synergy review analysis payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups", "items"],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "reviewItemIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "label": { "type": "string", "minLength": 1 },
          "reviewItemIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewItemId", "description", "confidence", "evidencePaths"],
        "properties": {
          "reviewItemId": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1, "maxLength": 600 },
          "confidence": { "enum": ["high", "medium", "low"] },
          "evidencePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "label", "start", "end"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "start": { "type": "integer", "minimum": 1 },
          "end": { "type": "integer", "minimum": 1 },
          "parentLabel": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
