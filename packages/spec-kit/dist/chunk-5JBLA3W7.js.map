{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/StatusProps",
  "definitions": {
    "StatusProps": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/StatusValue"
        },
        "note": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        },
        "dirty": {
          "type": "boolean"
        },
        "onChange": {
          "$comment": "(next: StatusValue) => void",
          "type": "object",
          "properties": {
            "namedArgs": {
              "type": "object",
              "properties": {
                "next": {
                  "$ref": "#/definitions/StatusValue"
                }
              },
              "required": [
                "next"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "StatusValue": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "in-progress",
        "blocked",
        "done",
        "shipped"
      ]
    }
  }
}
