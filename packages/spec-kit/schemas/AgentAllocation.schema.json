{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AgentAllocationProps",
  "definitions": {
    "AgentAllocationProps": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AgentAllocationEntry"
          }
        }
      },
      "required": [
        "entries"
      ],
      "additionalProperties": false
    },
    "AgentAllocationEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/AgentType"
        },
        "responsibility": {
          "type": "string"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          },
          "description": "Phases this agent touches — slugs (preferred) or legacy numbers."
        },
        "model": {
          "$ref": "#/definitions/AgentModel",
          "description": "Default model for fan-out, e.g. \"opus\". Overridable per run by the execute skill."
        },
        "effort": {
          "$ref": "#/definitions/AgentEffort",
          "description": "Default thinking effort for fan-out."
        },
        "count": {
          "type": "number",
          "description": "How many parallel instances to spawn."
        }
      },
      "required": [
        "name",
        "type",
        "responsibility"
      ],
      "additionalProperties": false
    },
    "AgentType": {
      "type": "string",
      "enum": [
        "sub-agent",
        "agent-team",
        "human"
      ]
    },
    "AgentModel": {
      "type": "string",
      "enum": [
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    "AgentEffort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "max"
      ]
    }
  }
}
