    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.0",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3"
  }
