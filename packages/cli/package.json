{
  "name": "@synergy/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Synergy CLI: init, preview, validate.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "synergy": "./dist/cli.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@synergy/preview": "workspace:*",
    "@synergy/spec-kit": "workspace:*",
    "@synergy/state": "workspace:*",
    "@synergy/validator": "workspace:*",
    "cac": "6.7.14",
    "gray-matter": "4.0.3",
    "kleur": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
