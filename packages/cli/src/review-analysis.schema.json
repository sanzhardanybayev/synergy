{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synergy review analysis input",
  "description": "Strict structural envelope accepted by review analysis-set. Diff reviews keep durable captured item IDs; scope reviews use temporary local section keys. Cross-reference ownership and uniqueness are validated semantically by the CLI parser because JSON Schema cannot express those relationships.",
  "oneOf": [{ "$ref": "#/$defs/diffAnalysis" }, { "$ref": "#/$defs/scopeAnalysis" }],
  "$defs": {
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "evidencePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "diffAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "items"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diffGroup" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diffItem" }
        },
        "removals": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/removalRationale" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileInsight" }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S" }
      }
    },
    "diffGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "reviewItemIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reviewItemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "intro": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" }
      }
    },
    "diffItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewItemId", "description", "confidence", "evidencePaths"],
      "properties": {
        "reviewItemId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidencePaths": { "$ref": "#/$defs/evidencePaths" }
      }
    },
    "scopeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "sections"],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scopeGroup" }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scopeSection" }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileInsight" }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S" }
      }
    },
    "scopeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "sectionKeys"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "sectionKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "intro": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" }
      }
    },
    "scopeSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "path",
        "label",
        "start",
        "end",
        "description",
        "confidence",
        "evidencePaths"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "parentLabel": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidencePaths": { "$ref": "#/$defs/evidencePaths" }
      }
    },
    "removalRunRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start", "end"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "removalRationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewItemId", "run", "reason", "description"],
      "properties": {
        "reviewItemId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "run": { "$ref": "#/$defs/removalRunRef" },
        "reason": {
          "enum": ["moved", "merged", "replaced", "dead-code", "obsolete", "extracted-to-dep"]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S" },
        "movedTo": { "$ref": "#/$defs/removalRunRef" }
      }
    },
    "fileInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "description", "confidence"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "pattern": "\\S"
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    }
  }
}
